{
  "id": "km_motordaten",
  "title": "Motordaten",
  "description": "Live-Motordaten der DME wie die M2-App: Temperaturen, Drücke, Drehzahl, Leistung, Klopfen; Maximalwerte, Logs, Fehlerspeicher lesen/löschen; MHD Max Cooling (wird automatisch erkannt).",
  "version": "0.2.0",
  "vendor": "Prototype019",
  "loggingId": "KMD1",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Motordaten",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Einstellungen"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Farben",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Rot"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Eisweiss"
        ],
        [
          "amber",
          "Nacht-Amber"
        ]
      ]
    },
    {
      "key": "tempUnit",
      "label": "Temperatur",
      "type": "choice",
      "default": "c",
      "options": [
        [
          "c",
          "Celsius"
        ],
        [
          "f",
          "Fahrenheit"
        ]
      ]
    }
  ]
